{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "check:no-mocks": "node scripts/assert-no-mocks.mjs",
    "build": "npm run check:no-mocks && prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test:audit": "playwright test tests/vbridge-audit-bots.spec.ts",
    "test:audit:ui": "playwright test tests/vbridge-audit-bots.spec.ts --ui",
    "test:pwa": "playwright test tests/pwa-mobile-twa.spec.ts",
    "test:contracts": "node scripts/test_phase_b_contracts.mjs",
    "test:perf": "node scripts/test_phase_c_performance.mjs",
    "test:scale": "node scripts/test_phase_d_scale_safety.mjs",
    "test:security": "node scripts/test_phase_e_security.mjs",
    "test:journeys": "node scripts/test_phase_f_user_journeys.mjs",
    "test:all": "npm run check:no-mocks && npm run test:contracts && npm run test:perf && npm run test:scale && npm run test:security && npm run test:journeys",
    "analyze": "node scripts/run_bundle_analyzer.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.54.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
