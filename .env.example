# Database (Supabase Supavisor Transaction Pooler on port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=15"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Auth & Secrets
NEXTAUTH_SECRET="replace-with-a-32-byte-base64-random-secret"
JWT_SECRET="replace-with-a-32-byte-base64-random-secret"
NEXTAUTH_URL="https://vbridgeconnect.vercel.app"
AUTH_TRUST_HOST="true"

# Supabase Client & Realtime
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Scheduled Cron Security
CRON_SECRET="replace-with-a-secure-cron-secret-token"

# AWS S3 Object Storage (Presigned Uploads)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="vbridgeconnect-production-deliverables"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

# Android TWA & App Settings
TWA_PACKAGE_NAME="in.edu.vit.vbridgeconnect"
TWA_SHA256_FINGERPRINT="14:6D:E9:17:86:14:0E:01:A0:63:F5:BD:98:97:54:19:BE:85:2E:39:19:D4:FF:6F:4D:5E:2B:60:A3:8C:36:20"
